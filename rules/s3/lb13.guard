let elbs = Resources.*[ Type == "AWS::ElasticLoadBalancingV2::LoadBalancer" ]

rule ELB_SUBNET_COUNT when %elbs !empty {
  %elbs.Properties.Subnets exists
  %elbs.Properties.Subnets is_list
  %elbs.Properties.Subnets.length >= 2
  %elbs.Properties.Subnets.length <= 3

  <<
    Violation: Load Balancer must span between 2 and 3 Availability Zones (subnets).
    Fix: Add or remove subnets so that the count is 2 or 3.
  >>
}
