let elbv2s = Resources.*[ Type == "AWS::ElasticLoadBalancingV2::LoadBalancer" ]

rule ELB_SUBNET_COUNT when %elbv2s !empty {
  %elbv2s.Properties.Subnets exists
  %elbv2s.Properties.Subnets is_list
  %elbv2s.Properties.Subnets.length >= 2

  <<
    Violation: Application Load Balancer must span at least 2 subnets (Availability Zones).
    Fix: Add subnets from different AZs to meet the high availability requirement.
  >>
}
