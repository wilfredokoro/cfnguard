let elbv2s = Resources.*[ Type == "AWS::ElasticLoadBalancingV2::LoadBalancer" ]

rule ELB_SUBNETS_COUNT when %elbv2s !empty {
  %elbv2s.Properties.Subnets exists
  %elbv2s.Properties.Subnets.length >= 2
  %elbv2s.Properties.Subnets.length <= 3

  <<
    Violation: Classic Load Balancer must span 2 or 3 subnets (AZs).
    Fix: Modify Subnets to include 2 or 3 for high availability.
  >>
}