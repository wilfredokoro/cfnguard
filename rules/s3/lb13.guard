rule ELB_SUBNETS_COUNT {
  let elbs = Resources.*[ Type == "AWS::ElasticLoadBalancingV2::LoadBalancer" ]

  check elbs exists

  check foreach elb in elbs {
    elb.Properties.Subnets exists
    length(elb.Properties.Subnets) >= 2
    length(elb.Properties.Subnets) <= 3
  }

  <<
    Violation: Load Balancer must span between 2 and 3 subnets (Availability Zones).
    Fix: Use exactly 2 or 3 subnets under Properties.Subnets.
  >>
}
